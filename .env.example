# Copy to .env at the repository root (gitignored) and fill in the secrets.
# The backend (run from backend/) reads ../.env, as does docker compose.

# --- Databricks SQL warehouse (required: the backend has no mock mode) ---
DATABRICKS_SERVER_HOSTNAME=adb-1023210238843247.7.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
NEWS_TABLE=ms_vulcan_gplng_plab.trader_news_app.platts_lng_top_news

# Service principal auth
DATABRICKS_USE_SERVICE_PRINCIPAL=true
DATABRICKS_TENANT_ID=<tenant-id>
DATABRICKS_CLIENT_ID=<client-id>
DATABRICKS_CLIENT_SECRET=<client-secret>
DATABRICKS_WORKSPACE_RESOURCE_ID=<full-resource-id>

# Or a personal access token instead of the service principal:
# DATABRICKS_USE_SERVICE_PRINCIPAL=false
# DATABRICKS_TOKEN=<pat>

# --- Pipeline button (optional) ---
DATABRICKS_WORKSPACE_URL=adb-1023210238843247.7.azuredatabricks.net
DATABRICKS_JOB_ID=93951735174333
