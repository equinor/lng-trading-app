FROM mcr.microsoft.com/playwright/python:v1.65.2-jammy

ENV PYTHONUNBUFFERED=1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app/

ENV PATH="/app/.venv/bin:$PATH"

COPY pyproject.toml uv.lock /app/
COPY backend/pyproject.toml /app/backend/

# Dependencies first so code changes reuse this layer. The collector group adds Playwright, numpy
# and Pillow; its version must match the Playwright image tag above, which ships the browsers.
RUN uv sync --frozen --no-install-workspace --no-dev --group collector --package app

COPY ./backend/app /app/backend/app
RUN uv sync --frozen --no-dev --group collector --package app

WORKDIR /app/backend/

# Radix runs containers as non-root and needs a numeric user id (a user name cannot be checked).
RUN adduser --disabled-password --gecos "" --uid 1001 appuser \
    && chown -R appuser:appuser /app
USER 1001

CMD ["python", "-m", "app.features.flare_monitor.collector"]
